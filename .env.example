# Database connection string (PostgreSQL on Neon for both development and production)
# Create a free database at https://neon.tech and paste the pooled connection string here.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-POOLER.REGION.aws.neon.tech/DBNAME?sslmode=require

# Local alternative (SQLite, for quick offline experiments):
# DATABASE_URL=file:./db/custom.db
